{
  "name": "story-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && node scripts/product-public.mjs && node scripts/cache-shell.mjs",
    "test:unit": "vitest run",
    "native:sync:android": "npm run build && cap sync android",
    "native:sync:ios": "npm run build && cap sync ios && node scripts/normalize-ios.mjs",
    "native:build:android": "node scripts/build-native.mjs android",
    "native:build:ios": "node scripts/build-native.mjs ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/network": "8.0.0",
    "@capawesome/capacitor-file-picker": "8.1.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "capacitor-secure-storage-plugin": "0.13.0",
    "idb": "8.0.2",
    "lucide-vue-next": "0.468.0",
    "pinia": "3.0.2",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.3",
    "marked": "18.0.3",
    "@vitejs/plugin-vue": "5.2.3",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "5.0.3",
    "vue-tsc": "2.2.10"
  }
}
