# Run python scripts/init-env.py to generate private secrets before starting.
COMPOSE_PROJECT_NAME=story-between
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8810
INSIGHTS_PORT=8812
POSTGRES_DB=story_between
POSTGRES_USER=reader
POSTGRES_PASSWORD=replace-with-a-generated-password
DATABASE_URL=postgresql+psycopg://reader:${POSTGRES_PASSWORD}@db:5432/story_between
JWT_SIGNING_SECRET=replace-with-a-random-signing-secret
PROVIDER_MASTER_KEY=replace-with-a-fernet-key
AI_MODE=mock
INTERACTIVE_WORLD_ENABLED=true
REGISTRATION_ENABLED=true
PRODUCT_UNLIMITED_USAGE=true
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8810,http://localhost:8810,http://127.0.0.1:8812,http://localhost:8812,http://127.0.0.1:18868,http://127.0.0.1:18869
PROVIDER_ALLOWED_HOSTS=api.openai.com,opencode.ai,apihub.agnes-ai.com
PRODUCT_PAYMENT_PROVIDER=disabled
PRODUCT_STORAGE_DRIVER=local
PRODUCT_PUBLIC_ORIGIN=http://127.0.0.1:8810
VITE_PUBLIC_ORIGIN=
ALLOW_LIVE_TESTS=false
LIVE_TEST_MAX_CALLS=0
