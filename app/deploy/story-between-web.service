[Unit]
Description=Story Between static client
After=network.target

[Service]
User=root
Environment=STORY_DIST=/root/workspace/story-between/client/dist
Environment=STORY_PORT=8810
ExecStart=/usr/bin/python3.11 /root/workspace/story-between/deploy/static_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
