[Unit]
Description=Story Between static client (dsh-story-between plugin)
After=network.target

[Service]
User=root
Environment=STORY_DIST=/root/workspace/plugins/dsh-story-between/app/client/dist
Environment=STORY_PORT=8810
ExecStart=/usr/bin/python3.11 /root/workspace/plugins/dsh-story-between/app/deploy/static_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
