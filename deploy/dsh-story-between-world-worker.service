[Unit]
Description=Story Between world worker (dsh-story-between plugin)
After=network.target

[Service]
User=root
WorkingDirectory=/root/workspace/plugins/dsh-story-between/app/server
EnvironmentFile=/root/workspace/plugins/dsh-story-between/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/workspace/plugins/dsh-story-between/app/venv/bin/python -m app.world.worker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
