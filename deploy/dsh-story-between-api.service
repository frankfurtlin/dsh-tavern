[Unit]
Description=Story Between API (dsh-story-between plugin backend)
After=network.target

[Service]
User=root
WorkingDirectory=/root/workspace/plugins/dsh-story-between/app/server
EnvironmentFile=/root/workspace/plugins/dsh-story-between/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/workspace/plugins/dsh-story-between/app/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --no-access-log --proxy-headers --forwarded-allow-ips *
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
