# dsh-tavern world worker — LEGACY, CANNOT START, DO NOT ENABLE.
#
# Kept only to document the unit that exists on the author's host. The module it
# runs, app/world/worker.py, was deleted together with the old story/world domain;
# `python -m app.world.worker` now fails with "No module named app.world.worker"
# and the unit would restart-loop. The author's host has it disabled.
#
# This file sits in deploy/systemd/legacy/ on purpose: the install command in the
# README copies deploy/systemd/*.example, and that glob must not pick up units that
# should stay disabled. Nothing here is loaded unless you copy it yourself.
#
# Fields you MUST change before copying: /opt/dsh/dsh-tavern (the checkout path,
# in WorkingDirectory, EnvironmentFile and ExecStart).

[Unit]
Description=Tavern world worker (dsh-tavern plugin) [legacy, unused]
After=network.target

[Service]
User=root
WorkingDirectory=/opt/dsh/dsh-tavern/app/server
EnvironmentFile=/opt/dsh/dsh-tavern/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dsh/dsh-tavern/app/venv/bin/python -m app.world.worker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
